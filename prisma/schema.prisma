generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  RECEIVED
  ASSIGNED
  ALLOCATION_FAILED
}

enum AssignmentKind {
  MANDATORY
  FAIR
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Service {
  id              Int              @id
  code            String           @unique
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  leads           Lead[]
  assignments     LeadAssignment[]
  allocationState AllocationState?
}

model Provider {
  id                     Int              @id
  code                   String           @unique
  name                   String           @unique
  monthlyQuota           Int              @default(10)
  quotaConsumedThisMonth Int              @default(0)
  active                 Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  assignments            LeadAssignment[]
}

model Lead {
  id              String           @id @default(cuid())
  serviceId       Int
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  city            String
  description     String?
  status          LeadStatus       @default(RECEIVED)
  allocationError String?
  assignedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignments     LeadAssignment[]

  @@unique([serviceId, phone], name: "lead_service_phone_unique")
  @@index([serviceId, createdAt])
  @@index([status, createdAt])
}

model LeadAssignment {
  id             Int            @id @default(autoincrement())
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceId      Int
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId     Int
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  assignmentKind AssignmentKind
  createdAt      DateTime       @default(now())

  @@unique([leadId, providerId], name: "lead_provider_unique")
  @@index([providerId, createdAt])
  @@index([serviceId, createdAt])
}

model AllocationState {
  id         Int      @id @default(autoincrement())
  serviceId  Int      @unique
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  nextPointer Int      @default(0)
  version    Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model WebhookEvent {
  id          Int           @id @default(autoincrement())
  eventId     String        @unique
  eventType   String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
